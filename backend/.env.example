# EstateFlow - Oracle Database Configuration
PORT=5000

# Oracle Connection Credentials
DB_USER=SYSTEM
DB_PASSWORD=25BBS0002
DB_CONNECT_STRING=localhost:1521/XE

# Oracle Client Library Directory (Optional: used for Thick mode with Oracle 11g XE)
# By default on Windows Oracle XE 11g, it is located at:
ORACLE_CLIENT_LIB_DIR=C:\oraclexe\app\oracle\product\11.2.0\server\bin

# Connection Pool Settings
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_INCREMENT=2
DB_POOL_TIMEOUT=60

# Authentication & JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h

